'type'				: 'iframe',
'scrolling'			: 'hidden',
'fitToView'	: true,
'autoSize' : false,
'preload' : false,
iframe: {
              preload: false
          },
beforeShow: function(){
		$(".fancybox-outer").css("background-color",$("#switchkleur").css("background-color"));
    },
